# Android
android/.gradle/
android/local.properties
android/**/build/
android/**/.cxx/
android/.idea/
android/*.iml

# iOS / Xcode
# TigerVNCViewer.xcodeproj is generated by `xcodegen generate` from
# project.yml (the tracked source of truth) -- not committed, to avoid
# pbxproj merge conflicts. Run xcodegen after cloning/pulling.
ios/*.xcodeproj/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/Pods/

# CMake
core/build/
build/

# third_party/{ios,android}: downloaded tarballs, extracted sources, and
# built artifacts are regenerated by build-deps.sh / build-core.sh in each
# -- only the scripts/toolchain files are tracked.
third_party/ios/src/
third_party/ios/src-sim/
third_party/ios/build/
third_party/ios/build-sim/
third_party/ios/sysroot/
third_party/ios/sysroot-sim/
third_party/ios/coretree/
third_party/android/src/
third_party/android/build/
third_party/android/sysroot/
third_party/android/coretree/

# OS
.DS_Store
